# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit real credentials.

# Neon Postgres connection string, from the Neon console.
# The project MUST be in the Frankfurt (eu-central-1) region — EU data
# residency is why Neon is the choice at all (route ticket 04).
DATABASE_URL="postgresql://user:password@host.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# better-auth session/token signing secret (slice 02). Min 32 chars.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-real-32-plus-character-secret"
# Base URL better-auth issues cookies and callbacks against. Matches the dev port.
BETTER_AUTH_URL="http://localhost:3001"

# Seed credentials for Mads's athlete account (slice 02). The seed creates his
# user through better-auth, so these are the details he logs in with locally.
SEED_MADS_EMAIL="mads@example.com"
SEED_MADS_PASSWORD="a-dev-password-min-8-chars"

# Anthropic API key for the Coach (slice 08). A SERVER secret: it is read
# server-side only and never ships to the browser — ADR 0006 retired the POC's
# enter-your-key-in-the-UI pattern. In deployment this is a Vercel environment
# variable. Without it, the Weekly Session and MCQ onboarding throw on first use.
ANTHROPIC_API_KEY="sk-ant-replace-me"

# Optional. The model the Coach runs on; defaults to claude-sonnet-5 when unset.
# Override to pin a different model per environment.
# COACH_MODEL="claude-sonnet-5"
