# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit real credentials.

# Neon Postgres connection string, from the Neon console.
# The project MUST be in the Frankfurt (eu-central-1) region — EU data
# residency is why Neon is the choice at all (route ticket 04).
DATABASE_URL="postgresql://user:password@host.eu-central-1.aws.neon.tech/dbname?sslmode=require"
