node_modules/
.fallow/
.claude/settings.local.json

# The skills CLI mirrors .agents/skills/ here as symlinks holding absolute paths
# into whichever checkout ran the install. The skills themselves are tracked
# under .agents/skills/; these links are per-checkout and portable to nobody.
.claude/skills/
*.log
.DS_Store
Thumbs.db

# Secrets — never commit. .env.example carries the placeholders instead.
.env
.env.*
!.env.example

# Next.js
.next/
out/
next-env.d.ts

# Build / test artifacts
dist/
coverage/
.vercel/
.turbo/
*.tsbuildinfo

# --- Private working docs — kept local only, never published ---
# This is a learning project. The planning corpus, concept notes, and prototype
# stay on the author's machine; the public repo leads with README.md and
# ABOUT.md instead. These files remain on disk (the agent tooling still reads
# them) — they are only removed from version control.
#
# Architecture decision records are the exception (2026-08-13): an ADR is the
# reasoning behind code that is already public, not planning material, so
# docs/adr/ is published while the rest of docs/ stays local.
/CONTEXT.md
/OVERVIEW.md
/CLAUDE.md
/.scratch/
/poc/
/docs/*
!/docs/adr/
/.agents/
/.claude/
/skills-lock.json
/.fallowrc.json
/lovable/

# Coach reply captures from `npm run coach:say` — local reading material,
# real API output, never committed.
.coach-say/

# Cached article XML for the Knowledge Oracle ingest. Fetched from PMC on
# demand and re-fetchable, so it is a build artifact rather than source. Whether
# CC BY article text should live in a public repo is a deliberate decision, not
# something a cache directory should make by accident.
.corpus-cache/

# Citation-chaining working data: reference lists mined from the cached corpus,
# and candidate article XML fetched while licence-checking them. Regenerable,
# and the same "is this text ours to commit?" question as .corpus-cache/.
.corpus-scout/
