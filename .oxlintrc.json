{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Fast lint pass (2026-09-22). Runs in ~3 s where ESLint took ~90 s. ESLint
  // (`eslint.config.mjs`) turns off everything listed here, so a file is never
  // judged twice; what still runs there is the `it.only` selector rule, which
  // Oxlint has no selector engine for, and the jsx-a11y set, which this file
  // deliberately does not enable.
  "plugins": ["typescript", "react", "nextjs", "import", "oxc"],
  // `error`, not `warn`: oxlint exits 0 on warnings, so a warn-level category
  // would leave `npm run lint` green on a real fault and quietly retire one of
  // the four Definition-of-Done checks. Severities below match what
  // eslint-config-next gave these rules on main.
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    // The POC is legacy CommonJS reference material we are porting into src/
    // (slice 08 ports its prompt logic to TypeScript). It intentionally uses
    // require() and is not held to the app's lint rules.
    "poc/**",
    // Playwright's component harness bundles React itself into this folder;
    // linting the bundle reports React's own internals as hook violations.
    "playwright/.cache/**",
    "test-results/**",
    "playwright-report/**"
  ],
  // What eslint-config-next used to bring in, at the severities it used.
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "nextjs/no-img-element": "warn",
    "nextjs/no-html-link-for-pages": "error",
    "typescript/no-unused-vars": "warn",
    "typescript/no-explicit-any": "error",
    // Two findings oxlint reports that eslint-config-next never ran. Neither is
    // a regression and neither is fixed here, so they stay visible at warn
    // rather than failing the gate on pre-existing code:
    // `garmin.ts` strips C0 control characters on purpose, and the `chunk.ts`
    // escape is harmless. Raise these once someone owns the two sites.
    "no-control-regex": "warn",
    "no-useless-escape": "warn"
  },
  "overrides": [
    // Scoped to app code. Test files are the legitimate consumers and are
    // exempted in the next override.
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        // Fixture modules build invented data byte by byte so the decode and
        // render paths can be tested without a real export. Both carry a
        // "TEST FIXTURES ONLY" comment at the top — and a comment does not
        // stop an import (CodeRabbit, PR #35), so the rule is enforced here
        // instead: a wrong import fails `npm run lint` rather than shipping a
        // synthetic-data path into the bundle, where it could reach a real
        // athlete's record.
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/fit-fixture",
                  "./fit-fixture",
                  "**/synthetic-fixtures",
                  "./synthetic-fixtures"
                ],
                "message": "Test fixtures only. This module builds invented data; importing it from app code risks synthetic data reaching a real athlete's record."
              }
            ]
          }
        ],
        // What must not reach a commit (added 2026-09-15, from the ECC
        // comparison in .scratch/research/ecc-workflow-comparison.md §3).
        // `console.error` and `console.warn` stay allowed: `lib/coach-log.ts`
        // is the Coach path's only logging and it writes structured lines to
        // console.error. A stray `console.log` is a debugging leftover, and on
        // the Coach path it is the one way an athlete's words could reach a
        // log line unredacted.
        "no-console": ["error", { "allow": ["warn", "error"] }],
        "no-debugger": "error"
      }
    },
    {
      "files": ["src/**/*.test.{ts,tsx}", "src/**/*.spec.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": "off",
        "no-console": "off",
        "no-debugger": "off"
      }
    }
  ]
}
