// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`casUpdateBlockSet — compare-and-swap on version, event in the same statement > renders the same statement every time — golden 1`] = `"WITH updated AS ( UPDATE "training_block_set" SET "blocks" = $1::jsonb, "version" = "training_block_set"."version" + 1, "updated_at" = now() WHERE "training_block_set"."id" = $2::uuid AND "training_block_set"."athlete_id" = $3::uuid AND "training_block_set"."version" = $4 RETURNING "training_block_set"."version" ), announced AS ( INSERT INTO "events" ( "athlete_id", "actor_type", "actor_id", "type", "payload" ) SELECT $5::uuid, $6, $7::uuid, $8, $9::jsonb WHERE EXISTS (SELECT 1 FROM "updated") RETURNING "events"."id" ) SELECT "version" FROM updated"`;

exports[`insertBlockSet — one statement, the event gated on the insert winning > renders the same statement every time — golden 1`] = `"WITH inserted AS ( INSERT INTO "training_block_set" ( "athlete_id", "race_id", "start_date", "blocks" ) VALUES ($1::uuid, $2::uuid, $3::date, $4::jsonb) ON CONFLICT ("athlete_id", "race_id") DO NOTHING RETURNING "training_block_set"."id" ), announced AS ( INSERT INTO "events" ( "athlete_id", "actor_type", "actor_id", "type", "payload" ) SELECT $5::uuid, $6, $7::uuid, $8, $9::jsonb WHERE EXISTS (SELECT 1 FROM "inserted") RETURNING "events"."id" ) SELECT (SELECT count(*) FROM inserted) AS inserted"`;

exports[`insertBlockSet — one statement, the event gated on the insert winning > writes no event at all when none is given 1`] = `"WITH inserted AS ( INSERT INTO "training_block_set" ( "athlete_id", "race_id", "start_date", "blocks" ) VALUES ($1::uuid, $2::uuid, $3::date, $4::jsonb) ON CONFLICT ("athlete_id", "race_id") DO NOTHING RETURNING "training_block_set"."id" ) SELECT (SELECT count(*) FROM inserted) AS inserted"`;
